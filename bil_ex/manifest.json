{
    "manifest_version": 3,
    "name": "Bilibili 小助手",
    "version": "1.0",
    "description": "切换 BiliBili 深色/亮色 模式",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/16.png",
            "48": "icons/48.png",
            "128": "icons/128.png"
        }
    },
    "icons": {
        "16": "icons/16.png",
        "48": "icons/48.png",
        "128": "icons/128.png"
    },
    "permissions": ["scripting", "activeTab","storage"],
    "host_permissions": ["*://www.bilibili.com/*"],
    "content_scripts": [
        {
        "matches": ["*://*.bilibili.com/*"],
        "js": ["content.js"],
        "run_at": "document_start"
        }
    ]
}
  